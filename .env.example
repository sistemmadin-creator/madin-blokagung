# ==============================================================================
# MADIN BLOKAGUNG (MADINA 1951 M) - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env.local dan isi nilai kredensial yang valid.
# PERINGATAN: JANGAN PERNAH COMMIT .env.local ATAU FILE .env KE DALAM REPOSITORI!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Koneksi Database Direct / Transaction Pooler (Server-side only)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Public key aman diekspos ke client (browser service worker)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BHHyuMT..."

# Private key WAJIB disimpan hanya di server (jangan beri prefix NEXT_PUBLIC_)
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@madinblokagung.com"

# ------------------------------------------------------------------------------
# 3. WHATSAPP GATEWAY (WAHA / BAILEYS HTTP API)
# ------------------------------------------------------------------------------
# Alamat server WAHA lokal atau tunnel tepercaya
WAHA_BASE_URL="http://localhost:3008"

# API Key WAHA (jika gateway mengaktifkan otentikasi)
WAHA_API_KEY="your-waha-api-key"

# Whitelist origin gateway untuk mode produksi (dipisahkan koma)
ALLOWED_WAHA_ORIGINS="http://localhost:3008"

# ------------------------------------------------------------------------------
# 4. SUBDOMAIN & ROUTING CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PUBLIC_PORTAL_URL="https://www.madinblokagung.com"
NEXT_PUBLIC_SISTEM_PORTAL_URL="https://sistem.madinblokagung.com"
